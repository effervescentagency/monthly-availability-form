{
  "redirects": [
    {
      "source": "/",
      "destination": "/fallback.html",
      "permanent": false
    },
    {
      "source": "/:slug(\\w+-\\d{4})",
      "destination": "/form/?s=:slug",
      "permanent": false
    },
    {
      "source": "/:slug(\\w+-\\d{4})/",
      "destination": "/form/?s=:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/fallback.html"
    }
  ]
}
